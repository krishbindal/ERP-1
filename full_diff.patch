+name: SchoolOS Unified Pipeline
+
+on:
+  push:
+    branches: [master]
+  pull_request:
+    branches: [master]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  validate:
+    name: Core Validation & E2E
+    runs-on: [self-hosted, linux, x64, schoolos-ci]
+
+    steps:
+      - name: Checkout commit
+        uses: actions/checkout@v5
+        with:
+          clean: true
+          fetch-depth: 0
+
+      - name: Setup Node
+        uses: actions/setup-node@v5
+        with:
+          node-version: '22'
+
+      - name: Install dependencies
+        run: npm ci --ignore-scripts
+
+      - name: Verify Playwright Browsers
+        run: |
+          chmod +x scripts/ci-runner-preflight.sh
+          ./scripts/ci-runner-preflight.sh
+
+      - name: Lint
+        run: npm run lint --workspaces --if-present
+
+      - name: Typecheck
+        run: npm run typecheck --workspaces --if-present
+
+      - name: Unit Tests
+        run: npm run test --workspaces --if-present
+
+      - name: Run Full Audit (Artifact)
+        run: npm audit --json > audit-full.json || true
+
+      - name: Run Production Audit (Artifact)
+        run: npm audit --omit=dev --json > audit-prod.json || true
+
+      - name: Security Gate (Check exceptions)
+        run: node scripts/security-audit-gate.js < audit-full.json
+
+      - name: Cleanup Stale Environment
+        run: |
+          chmod +x scripts/ci-cleanup.sh
+          ./scripts/ci-cleanup.sh
+
+      - name: Verify Clean State
+        run: |
+          STALE=$(docker ps -q -f label=com.supabase.cli.project=ERP_1)
+          if [ -n "$STALE" ]; then
+            echo "::error::Stale containers for ERP_1 remain after cleanup!"
+            docker ps -a -f label=com.supabase.cli.project=ERP_1
+            exit 1
+          fi
+
+      - name: Environment Preflight
+        run: |
+          chmod +x scripts/ci-env-preflight.sh
+          ./scripts/ci-env-preflight.sh
+
+      - name: Start Local Supabase
+        run: |
+          if ! timeout 600s npx --no-install supabase start -x realtime -x studio -x postgres-meta -x mailpit -x imgproxy -x logflare -x vector -x supavisor --debug > start_output.log 2>&1; then
+            echo "::error::Supabase start failed or timed out!"
+            echo "--- Diagnostic Trap ---"
+            docker ps -a
+            for c in $(docker ps -a -q -f label=com.supabase.cli.project=ERP_1); do
+              echo "--- Inspecting $c ---"
+              docker inspect $c
+              docker inspect $c --format '{{json .State}}'
+              docker inspect $c --format '{{.State.ExitCode}}'
+              docker inspect $c --format '{{.State.Error}}'
+              docker inspect $c --format '{{.State.OOMKilled}}'
+              echo "--- Logs $c ---"
+              docker logs $c || true
+              echo "--- Port $c ---"
+              docker port $c || true
+            done
+            echo "--- System Diagnostics ---"
+            docker stats --no-stream || true
+            docker events --since 5m --until 0m -f label=com.supabase.cli.project=ERP_1 || true
+            ss -ltnp || true
+            docker network ls || true
+            docker network inspect supabase_network_ERP_1 || true
+            echo "--- Start Output ---"
+            cat start_output.log || true
+            exit 1
+          fi
+
+      - name: Wait for PostgreSQL Readiness
+        run: |
+          echo "Waiting for PostgreSQL to be ready..."
+          DB_CONTAINER=$(docker ps -q -f label=com.supabase.cli.project=ERP_1 -f name=supabase_db_)
+          if [ -n "$DB_CONTAINER" ]; then
+            until docker exec $DB_CONTAINER pg_isready -U postgres; do
+              echo "Waiting for postgres..."
+              sleep 2
+            done
+          else
+            echo "Supabase DB container not found!"
+            exit 1
+          fi
+
+      - name: Database Tests (pgTAP & RLS)
+        run: |
+          echo "Discovering Supabase configuration..."
+          DB_CONTAINER=$(docker ps -qf name="supabase_db_")
+          if [ -z "$DB_CONTAINER" ]; then
+            echo "Supabase DB container not found!"
+            exit 1
+          fi
+          NETWORK_NAME=$(docker inspect $DB_CONTAINER --format='{{range $k, $v := .NetworkSettings.Networks}}{{$k}}{{end}}')
+          DB_NAME=$(docker inspect $DB_CONTAINER --format='{{.Name}}' | sed 's/^\///')
+          echo "Network: $NETWORK_NAME"
+          echo "DB Host: $DB_NAME"
+          docker exec "$DB_NAME" psql -U postgres -d postgres -c "CREATE EXTENSION IF NOT EXISTS pgtap WITH SCHEMA extensions;"
+          docker volume create pg_tests_volume
+          docker create -v pg_tests_volume:/tests --name pg_tests_dummy alpine /bin/true
+          docker cp ${{ github.workspace }}/supabase/tests/. pg_tests_dummy:/tests/
+          docker rm pg_tests_dummy
+          TEST_EXIT=0
+          set +e
+          docker run --rm \
+            --network "$NETWORK_NAME" \
+            -v pg_tests_volume:/tests:ro \
+            -e PGHOST="$DB_NAME" -e PGUSER=postgres -e PGPASSWORD=postgres -e PGDATABASE=postgres \
+            public.ecr.aws/supabase/pg_prove:3.36_amd64@sha256:715739e7fdd07a8631c36ea2f1c88fc0144f99a8f5eaa6c3a9799be377f94f2c \
+            pg_prove --ext .sql -r /tests/db
+          TEST_EXIT=$?
+          set -e
+          CLEANUP_EXIT=0
+          docker exec "$DB_NAME" psql -U postgres -d postgres -v ON_ERROR_STOP=1 -c "DROP EXTENSION IF EXISTS pgtap;" || CLEANUP_EXIT=$?
+          docker volume rm pg_tests_volume || true
+          if [ "$TEST_EXIT" -ne 0 ]; then exit "$TEST_EXIT"; fi
+          if [ "$CLEANUP_EXIT" -ne 0 ]; then exit "$CLEANUP_EXIT"; fi
+          echo "Database tests and pgTAP cleanup completed successfully."
+
+      - name: Export Supabase Environment Variables
+        run: |
+          API_URL=$(npx --no-install supabase status -o env | grep API_URL | cut -d '=' -f2- | sed 's/[^a-zA-Z0-9:\/\.\_\-]//g')
+          ANON_KEY=$(npx --no-install supabase status -o env | grep ANON_KEY | cut -d '=' -f2- | sed 's/[^a-zA-Z0-9:\/\.\_\-]//g')
+          SERVICE_KEY=$(npx --no-install supabase status -o env | grep SERVICE_ROLE_KEY | cut -d '=' -f2- | sed 's/[^a-zA-Z0-9:\/\.\_\-]//g')
+          echo "NEXT_PUBLIC_SUPABASE_URL=$API_URL" >> $GITHUB_ENV
+          echo "NEXT_PUBLIC_SUPABASE_ANON_KEY=$ANON_KEY" >> $GITHUB_ENV
+          echo "SUPABASE_SERVICE_ROLE_KEY=$SERVICE_KEY" >> $GITHUB_ENV
+          echo "NEXT_PUBLIC_SUPABASE_URL: ${API_URL:+PRESENT}"
+          echo "NEXT_PUBLIC_SUPABASE_ANON_KEY: ${ANON_KEY:+PRESENT}"
+          echo "SUPABASE_SERVICE_ROLE_KEY: ${SERVICE_KEY:+PRESENT}"
+          if ! [[ "$API_URL" =~ ^https?:// ]]; then exit 1; fi
+          if [[ -z "$API_URL" || -z "$ANON_KEY" ]]; then exit 1; fi
+
+      - name: Build Web
+        run: npm run build:web
+
+      - name: Worker Runtime Certification
+        run: |
+          echo "USE_MOCK_PROVIDERS=true" > supabase/.env.local
+          npx --no-install supabase functions serve communication-worker --env-file supabase/.env.local --no-verify-jwt &
+          for i in {1..15}; do
+            STATUS=$(curl -s -o /dev/null -w "%{http_code}" http://127.0.0.1:54321/functions/v1/communication-worker || echo "000")
+            if [ "$STATUS" = "405" ] || [ "$STATUS" = "401" ]; then break; fi
+            sleep 2
+          done
+          node scripts/test-worker.js
+
+      - name: Run Playwright Tests
+        env:
+          PLAYWRIGHT_GIT_COMMIT_INFO: 0
+          PLAYWRIGHT_JSON_OUTPUT_NAME: playwright-report/results.json
+        run: |
+          cd apps/web
+          npx --no-install playwright test --reporter=line,json
+
+      - name: Verify JSON Certification Artifact
+        run: node scripts/verify-playwright-results.js apps/web/playwright-report/results.json
+
+      - name: Upload Certification Artifacts
+        uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: schoolos-certification-artifacts
+          path: |
+            apps/web/playwright-report/results.json
+            audit-full.json
+            audit-prod.json
+          retention-days: 14
+
+      - name: Cleanup Workspace
+        if: always()
+        run: |
+          pkill -f "playwright" || true
+          pkill -f "chrome" || true
+          pkill -f "webkit" || true
+          pkill -f "next" || true
+          pkill -f "supabase functions serve" || true
