{
  "name": "schoolos",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=apps/web",
    "start:web": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:db": "npx supabase test db",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "supabase:test": "npx supabase test db",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build",
    "postinstall": "node scripts/patch-vitest-timeout.js"
  },
  "devDependencies": {
    "supabase": "^2.115.0"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
