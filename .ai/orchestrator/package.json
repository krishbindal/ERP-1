{
  "name": "@schoolos/ai-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Local Antigravity CLI executor prototype for SchoolOS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dry-run": "node dist/index.js",
    "execute": "node dist/index.js --execute",
    "prestart": "npm run build",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
